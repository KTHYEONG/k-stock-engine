[Unit]
Description=KSE daily audit (outcome and artefact check with heartbeat)
OnFailure=kse-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-stock-engine
Environment=TZ=Asia/Seoul
TimeoutStartSec=20min
ExecStart=/usr/bin/docker run --rm --log-opt max-size=10m --log-opt max-file=3 --name kse-daily-audit --user %U:%G -e HOME=/tmp -e UV_CACHE_DIR=/tmp/uv-cache --memory=512m --memory-swap=512m --cpus=0.5 --env-file %h/quant-secrets/k-stock-engine.env --env-file %h/quant-secrets/kis-data.env --env-file %h/quant-secrets/kse-alert.env -v %h/.cache/kis:/app/.cache/kis -e KIS_TOKEN_CACHE_DIR=/app/.cache/kis -v %h/k-stock-engine/data:/app/data -v %h/k-stock-engine/logs:/app/logs ghcr.io/kthyeong/k-stock-engine:latest uv run python -m src.ops.jobs audit
ExecStopPost=-/usr/bin/docker rm -f kse-daily-audit
