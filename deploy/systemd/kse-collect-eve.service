[Unit]
Description=KSE evening collection (everything except KRX-derived nodes)
OnFailure=kse-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-stock-engine
Environment=TZ=Asia/Seoul
TimeoutStartSec=3h
ExecStart=/usr/bin/docker run --rm --log-opt max-size=10m --log-opt max-file=3 --name kse-collect-eve --user %U:%G -e HOME=/tmp -e _RJEM_MALLOC_CONF=dirty_decay_ms:0,muzzy_decay_ms:0 -e UV_CACHE_DIR=/tmp/uv-cache --memory=3g --memory-swap=3g --cpus=1.5 --env-file %h/quant-secrets/k-stock-engine.env --env-file %h/quant-secrets/kis-data.env -v %h/.cache/kis:/app/.cache/kis -e KIS_TOKEN_CACHE_DIR=/app/.cache/kis -e BROKER_ADMISSION_CLASS=bulk -e KSE_KIND_TRANSPORT=relay -v %h/k-stock-engine/data:/app/data -v %h/k-stock-engine/logs:/app/logs ghcr.io/kthyeong/k-stock-engine:latest uv run python -m src.ops.jobs collect-eve
ExecStopPost=-/usr/bin/docker rm -f kse-collect-eve
