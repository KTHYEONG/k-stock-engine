[Unit]
Description=KSE evening collection (everything except KRX-derived nodes)
OnFailure=kse-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-stock-engine
Environment=TZ=Asia/Seoul
TimeoutStartSec=3h
ExecStart=%h/.local/lib/kse/kse-run collect-eve
ExecStopPost=-/usr/bin/docker rm -f kse-collect-eve
