[Unit]
Description=KSE morning seal (wait KRX bars, build, decide, shadow-run)
OnFailure=kse-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-stock-engine
Environment=TZ=Asia/Seoul
TimeoutStartSec=30min
ExecStart=%h/.local/lib/kse/kse-run morning
ExecStopPost=-/usr/bin/docker rm -f kse-morning
