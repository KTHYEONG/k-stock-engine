[Unit]
Description=KSE morning seal (wait KRX bars, build, decide, shadow-run)
# A failed seal starts the late seal at once; only its failure pages (src/ops/alert_policy.py).
OnFailure=kse-alert@%n.service kse-morning-late.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-stock-engine
Environment=TZ=Asia/Seoul
TimeoutStartSec=30min
ExecStart=%h/.local/lib/kse/kse-run morning
ExecStopPost=-/usr/bin/docker rm -f kse-morning
