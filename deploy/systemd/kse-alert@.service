[Unit]
Description=KSE alert for %i (unit failure notification)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-stock-engine
Environment=TZ=Asia/Seoul
TimeoutStartSec=5min
ExecStart=/bin/sh -c 'journalctl --user -u "$$0" -n 40 -o cat --no-pager | %h/.local/lib/kse/kse-run alert --unit "$$0" --result "$$(systemctl --user show -p Result --value "$$0")" --exit-status "$$(systemctl --user show -p ExecMainStatus --value "$$0")"' %i
ExecStopPost=-/usr/bin/docker rm -f kse-alert-notify
